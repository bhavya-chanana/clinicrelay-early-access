# Copy to .env and fill in. `node scripts/build.mjs` turns these into public/config.js.
# Nothing here is a secret: every value ends up in the public page. For GitHub Pages, set the
# same names under Settings -> Secrets and variables -> Actions -> Variables (not Secrets).

# Razorpay Payment Page link, e.g. https://rzp.io/rzp/abc123
# Empty = Reserve buttons fall back to WhatsApp, then email.
PAYMENT_URL=

# Google Apps Script web-app URL ending in /exec (apps-script/onboarding.gs)
# Empty = onboarding form offers "Send on WhatsApp" instead.
ONBOARDING_ENDPOINT=

# Your WhatsApp number, international format, digits only, e.g. 919876543210
WHATSAPP_NUMBER=

# Contact email shown on the page (optional)
CONTACT_EMAIL=

# Offer (rupees). Keep DEPOSIT_INR identical to the amount on the Razorpay page.
DEPOSIT_INR=999
FOUNDING_PRICE_INR=1999
LIST_PRICE_INR=2499
SETUP_FEE_INR=5000
FOUNDING_LOCK_MONTHS=6
FOUNDING_SPOTS=25
